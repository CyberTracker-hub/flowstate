# FLOWSTATE needs NO secrets and NO API keys.
#
# The collector reads the public DexScreener API (no key) and the website is
# static. The variables below are optional switches, shown with their defaults.

# --- Collector (pnpm collect) ---------------------------------------------------
# Where state.json and public/*.json are written.
FLOWSTATE_DATA_DIR=.data
# Which tokens to monitor.
FLOWSTATE_TOKENS=config/tokens.json

# --- Website build (pnpm web:build) ---------------------------------------------
# Where the browser fetches the published JSON from. Unset = "<base path>/data",
# i.e. apps/web/public/data (fill it with `pnpm web:demo-data` for a preview).
# In production the Pages workflow sets it to the repository's data branch:
# NEXT_PUBLIC_DATA_URL=https://raw.githubusercontent.com/OWNER/REPO/data/public
# Path prefix when the site is served from a sub-path, e.g. "/flowstate".
# NEXT_PUBLIC_BASE_PATH=
