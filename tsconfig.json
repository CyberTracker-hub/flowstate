{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@flowstate/anomaly-engine": ["./packages/anomaly-engine/src/index.ts"],
      "@flowstate/shared": ["./packages/shared/src/index.ts"],
      "@flowstate/market-data": ["./packages/market-data/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src"]
}
